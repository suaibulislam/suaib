---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="404"
  description="this page doesn't exist."
  canonical="https://suaib.is-a.dev/404"
  hideHeader={true}
>
  <div class="full-page-wrapper">
    <section class="section page-404">
      <div class="error-content">
        <div class="error-visual">
          <div class="error-code">404</div>
          <div class="error-emoji">:)</div>
        </div>

        <h2 class="section-heading">this page does not exist</h2>

        <div class="about-content">
          <p>
            not sure how you got here. sorry about that.
          </p>
        </div>

        <a href="/" class="back-link">← back home</a>
      </div>
    </section>
  </div>

  <style>
    :global(.main-content) {
      padding: 0 !important;
      max-width: 100% !important;
      margin: 0 !important;
    }

    .full-page-wrapper {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      width: 100%;
      background-color: var(--bg-primary);
      padding: 2rem;
      box-sizing: border-box;
    }

    .page-404 {
      width: min(100%, 640px);
      margin: 0 auto;
      text-align: center;
    }

    .error-content {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      width: 100%;
    }

    .error-visual {
      display: flex;
      align-items: baseline;
      justify-content: center;
      gap: 1rem;
      margin-bottom: 1.5rem;
      color: var(--primary-color);
    }

    .error-code {
      font-family: "JetBrains Mono", monospace;
      font-size: clamp(5rem, 18vw, 9rem);
      font-weight: 700;
      line-height: 1;
      letter-spacing: -0.08em;
    }

    .error-emoji {
      font-family: "JetBrains Mono", monospace;
      font-size: clamp(1.5rem, 5vw, 2.5rem);
      transform: rotate(-8deg);
    }

    .page-404 .section-heading {
      margin-bottom: 1.5rem;
    }

    .page-404 .about-content {
      max-width: 32rem;
      color: var(--text-secondary);
    }

    .page-404 .about-content p {
      margin: 0;
      line-height: 1.7;
    }

    .page-404 .back-link {
      margin-top: 2rem;
    }

    @media (max-width: 480px) {
      .full-page-wrapper {
        padding: 1.25rem;
      }
    }
  </style>
</BaseLayout>
