---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout
  title="connect with suaib"
  description="here's where i exist on the internet."
  canonical="https://suaib.is-a.dev/connect"
>
  <section class="connect-section">
    <h1 class="section-heading">connect</h1>
    <div class="connect-content">
      <div class="connect-intro">
        <p>
        if you want to reach out, or just see what i'm up to, here's where you can find me.
      </p>
      </div>

      <div class="social-grid">
        <a
          href="https://github.com/suaibulislam"
          class="social-card"
          target="_blank"
          rel="noopener"
        >
          <div class="social-icon">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="feather feather-github"
              ><path
                d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"
              ></path></svg
            >
          </div>
          <div class="social-text">
            <span class="social-label">github</span>
            <span class="social-handle">@suaibulislam</span>
          </div>
        </a>

        <a
          href="https://discord.com/users/1380331017172287571"
          class="social-card"
          target="_blank"
          rel="noopener"
        >
          <div class="social-icon">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              >
              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
              <path d="M8 12a1 1 0 1 0 2 0a1 1 0 0 0 -2 0" />
              <path d="M14 12a1 1 0 1 0 2 0a1 1 0 0 0 -2 0" />
              <path d="M15.5 17c0 1 1.5 3 2 3c1.5 0 2.833 -1.667 3.5 -3c.667 -1.667 .5 -5.833 -1.5 -11.5c-1.457 -1.015 -3 -1.34 -4.5 -1.5l-.972 1.923a11.913 11.913 0 0 0 -4.053 0l-.975 -1.923c-1.5 .16 -3.043 .485 -4.5 1.5c-2 5.667 -2.167 9.833 -1.5 11.5c.667 1.333 2 3 3.5 3c.5 0 2 -2 2 -3" />
              <path d="M7 16.5c3.5 1 6.5 1 10 0" />
            </svg>
          </div>
          <div class="social-text">
            <span class="social-label">discord</span>
            <span class="social-handle">blankeed</span>
          </div>
        </a>

        <a
          href="mailto:hey@suaib.is-a.dev"
          class="social-card"
        >
          <div class="social-icon">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path
                d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
              ></path><polyline points="22,6 12,13 2,6"></polyline></svg
            >
          </div>
          <div class="social-text">
            <span class="social-label">email</span>
            <span class="social-handle">hey@suaib.is-a.dev</span>
          </div>
        </a>

        <a
          href="https://anilist.co/user/blankeed"
          class="social-card"
          target="_blank"
          rel="noopener"
        >
          <div class="social-icon">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="currentColor"
              >
              <path d="M24 17.53v2.421c0 .71-.391 1.101-1.1 1.101h-5l-.057-.165L11.84 3.736c.106-.502.46-.788 1.053-.788h2.422c.71 0 1.1.391 1.1 1.1v12.38H22.9c.71 0 1.1.392 1.1 1.101zM11.034 2.947l6.337 18.104h-4.918l-1.052-3.131H6.019l-1.077 3.131H0L6.361 2.948h4.673zm-.66 10.96-1.69-5.014-1.541 5.015h3.23z"/>
            </svg>
          </div>
          <div class="social-text">
            <span class="social-label">anilist</span>
            <span class="social-handle">blankeed</span>
          </div>
        </a>

        <a
          href="https://link.clashofclans.com/?action=OpenPlayerProfile&tag=G2YY2PP9U"
          class="social-card"
          target="_blank"
          rel="noopener"
        >
          <div class="social-icon">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              >
              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
              <path d="M20 4v5l-9 7l-4 4l-3 -3l4 -4l7 -9z" />
              <path d="M6.5 11.5l6 6" />
            </svg>
          </div>
          <div class="social-text">
            <span class="social-label">clash of clans</span>
            <span class="social-handle">#G2YY2PP9U</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  .connect-section {
    max-width: 800px;
    margin: 0 auto 4rem;
    width: 100%;
  }

  .connect-intro {
    margin-bottom: 3rem;
  }

  .social-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .social-card {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1.5rem;
    background: transparent;
    border: 3px dotted var(--border-color);
    border-radius: var(--radius-md, 12px);
    text-decoration: none;
    color: var(--text-primary);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .social-card:hover {
    background: var(--bg-secondary);
    border-color: var(--primary-color);
    transform: translateY(-4px);
    box-shadow: 0 4px 12px rgba(var(--primary-rgb), 0.1);
  }

  .social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background: transparent;
    border: 3px dotted var(--border-color);
    border-radius: 50%;
    color: var(--primary-color);
  }

  .social-text {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .social-label {
    font-family: "Lexend", sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-secondary);
    text-transform: lowercase;
  }

  .social-handle {
    font-family: "JetBrains Mono", monospace;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  @media (max-width: 600px) {
    .social-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
