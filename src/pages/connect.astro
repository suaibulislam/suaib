---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout
  title="connect with suaib"
  description="here's where i exist on the internet."
  canonical="https://suaib.is-a.dev/connect"
>
  <section class="connect-section">
    <h1 class="section-heading">connect</h1>
    <div class="connect-content">
      <div class="connect-intro">
        <p>
          i'm usually around. if you want to chat about something, here's where
          i exist.
        </p>
      </div>

      <div class="social-grid">
        <a
          href="https://github.com/suaibulislam"
          class="social-card"
          target="_blank"
          rel="noopener"
        >
          <div class="social-icon">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="feather feather-github"
              ><path
                d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"
              ></path></svg
            >
          </div>
          <div class="social-text">
            <span class="social-label">github</span>
            <span class="social-handle">@suaibulislam</span>
          </div>
        </a>

        <a
          href="https://discord.com/users/1380331017172287571"
          class="social-card"
          target="_blank"
          rel="noopener"
        >
          <div class="social-icon">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="currentColor"
              ><path
                d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.947 2.418-2.157 2.418z"
              ></path></svg
            >
          </div>
          <div class="social-text">
            <span class="social-label">discord</span>
            <span class="social-handle">blankeed</span>
          </div>
        </a>

        <a
          href="mailto:hey@suaib.is-a.dev"
          class="social-card"
        >
          <div class="social-icon">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path
                d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
              ></path><polyline points="22,6 12,13 2,6"></polyline></svg
            >
          </div>
          <div class="social-text">
            <span class="social-label">email</span>
            <span class="social-handle">hey@suaib.is-a.dev</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  .connect-section {
    max-width: 800px;
    margin: 0 auto 4rem;
    width: 100%;
  }

  .connect-intro {
    margin-bottom: 3rem;
  }

  .social-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .social-card {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1.5rem;
    background: transparent;
    border: 3px dotted var(--border-color);
    border-radius: var(--radius-md, 12px);
    text-decoration: none;
    color: var(--text-primary);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .social-card:hover {
    background: var(--bg-secondary);
    border-color: var(--primary-color);
    transform: translateY(-4px);
    box-shadow: 0 4px 12px rgba(var(--primary-rgb), 0.1);
  }

  .social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background: transparent;
    border: 3px dotted var(--border-color);
    border-radius: 50%;
    color: var(--primary-color);
  }

  .social-text {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .social-label {
    font-family: "Lexend", sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-secondary);
    text-transform: lowercase;
  }

  .social-handle {
    font-family: "JetBrains Mono", monospace;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  @media (max-width: 600px) {
    .social-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
