---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout
  title="suaib"
  description="suaib's personal site. small things for the internet."
  canonical="https://suaib.is-a.dev/"
>
  <section class="about-section">
    <h1 class="section-heading">hello</h1>
    <div class="about-content">
      <p>
        i'm suaib. i make <a href="/projects" class="subtle-link"
          >small things</a
        > for the internet. i pick stuff up, get way too into it, build something,
        and then forget about it. that's basically the whole process. i also watch
        a lot of anime. sports genre mostly. <a
          href="https://myanimelist.net/anime/57181/Ao_no_Hako"
          class="subtle-link"
          target="_blank"
          rel="noopener">blue box</a
        > and <a
          href="https://myanimelist.net/anime/49052/Ao_Ashi"
          class="subtle-link"
          target="_blank"
          rel="noopener">ao ashi</a
        > are recent favourites. oh and i play clash of clans, town hall 18 if
        that means anything to you.
      </p>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  .about-section {
    margin-bottom: 3rem;
  }

  .about-content p {
    font-size: 1rem;
    margin-bottom: 1.5rem;
    max-width: 100%;
    text-align: left;
  }

  .subtle-link {
    color: var(--text-primary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .subtle-link:hover {
    color: var(--primary-color);
  }
</style>
