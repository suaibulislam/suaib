---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";

interface AnimeItem {
  title: string;
  url: string;
}

let animeItems: AnimeItem[] = [
  { title: "one piece", url: "https://myanimelist.net/anime/21/One_Piece" }
];

try {
  const res = await fetch('https://api.jikan.moe/v4/users/blankeed/animelist?status=watching');
  const data = await res.json();
  
  if (data?.data?.length > 0) {
    animeItems = data.data.map((item: any) => ({
      title: item.node.title.toLowerCase(),
      url: item.node.url || `https://myanimelist.net/anime/${item.node.id}`
    }));
  }
} catch (err) {
  console.error("failed to fetch anime list at build time:", err);
}
---

<BaseLayout
  title="suaib"
  description="suaib's personal site. small web projects."
  canonical="https://suaib.is-a.dev/"
>
  <section class="about-section">
    <h1 class="section-heading">hello</h1>
    <div class="about-content">
      <p>
        i'm suaib. i build <a href="/projects" class="subtle-link"
          >small web projects</a
        > whenever an idea catches my interest. outside of that, i usually watch
        anime, currently 
        {animeItems.map((anime, index) => (
          <>
            <a href={anime.url} class="subtle-link" target="_blank" rel="noopener">{anime.title}</a>
            {index < animeItems.length - 1 ? (index === animeItems.length - 2 ? ' and ' : ', ') : ''}
          </>
        ))}, or occasionally check in on clash of clans.
      </p>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  .about-section {
    margin-bottom: 3rem;
  }

  .about-content p {
    font-size: 1rem;
    margin-bottom: 1.5rem;
    max-width: 100%;
    text-align: left;
  }

  .subtle-link {
    color: var(--text-primary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .subtle-link:hover {
    color: var(--primary-color);
  }
</style>
