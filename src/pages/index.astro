---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout
  title="suaib"
  description="suaib's personal site. small web projects."
  canonical="https://suaib.is-a.dev/"
>
  <section class="about-section">
    <h1 class="section-heading">hello</h1>
    <div class="about-content">
      <p>
        hi, i'm suaib. i build <a href="/projects" class="subtle-link"
          >small web projects</a
        > whenever an idea catches my interest. outside of that, i usually watch
        anime, currently <a
          id="anime-link"
          href="https://myanimelist.net/animelist/blankeed"
          class="subtle-link"
          target="_blank"
          rel="noopener"><span id="anime-output">one piece</span></a
        >, or occasionally check in on clash of clans.
      </p>
    </div>
  </section>

  <Footer />
</BaseLayout>

<script>
  async function fetchAnime() {
    const username = "blankeed";
    const linkEl = document.getElementById('anime-link') as HTMLAnchorElement;
    const outputEl = document.getElementById('anime-output');

    try {
      const res = await fetch(`https://api.jikan.moe/v4/users/${username}/animelist?status=watching`);
      const data = await res.json();
      
      if (data?.data?.length > 0) {
        const titles = data.data.map(item => item.node.title);
        if (outputEl) {
          outputEl.textContent = titles.join(', ').toLowerCase();
        }
        if (linkEl) {
          linkEl.href = `https://myanimelist.net/animelist/${username}?status=1`;
        }
      }
    } catch (err) {
      console.error("failed to load anime list:", err);
    }
  }

  fetchAnime();
</script>

<style>
  .about-section {
    margin-bottom: 3rem;
  }

  .about-content p {
    font-size: 1rem;
    margin-bottom: 1.5rem;
    max-width: 100%;
    text-align: left;
  }

  .subtle-link {
    color: var(--text-primary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .subtle-link:hover {
    color: var(--primary-color);
  }
</style>
