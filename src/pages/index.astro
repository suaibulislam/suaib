---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
import TechStack from "../components/TechStack.astro";
---

<BaseLayout
  title="suaib"
  description="suaib's personal site. small things for the internet."
  canonical="https://suaib.is-a.dev/"
>
  <section class="about-section">
    <h1 class="section-heading">hello</h1>
    <div class="about-content">
      <p>
        i'm suaib. i make small things for the internet.<br />
        i pick things up, get obsessed, then move on, that's basically it.<br />
        i watch a lot of anime, sports genre mostly. blue box is a recent favourite.<br
        />
        i also play clash of clans. town hall 18, if that means anything to you.<br
        />
        oh btw, i'm supposed to be studying right now.
      </p>

      <TechStack />
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  .about-section {
    margin-bottom: 3rem;
  }

  .about-content p {
    font-size: 1rem;
    margin-bottom: 1.5rem;
    max-width: 100%;
    text-align: left;
  }
</style>
