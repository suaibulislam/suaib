---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout
  title="suaib"
  description="suaib's personal website. i build small web projects and share what i'm learning."
  canonical="https://suaib.is-a.dev/"
>
  <section class="home-intro" aria-labelledby="home-title">
    <h1 id="home-title">hello, i'm suaib<span class="home-period">.</span></h1>
    <p>
      i'm a student who enjoys building things for the web. i make
      <a href="/projects">small web projects</a>, explore ideas, and keep learning
      along the way.
    </p>
    <p class="home-links">
      take a look at <a href="/projects">my projects</a>,
      read <a href="/blogs">my notes</a>, or <a href="/connect">get in touch</a>.
    </p>
  </section>

  <Footer />
</BaseLayout>
