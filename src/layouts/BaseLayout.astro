---
import Header from "../components/Header.astro";
import { ClientRouter } from "astro:transitions";
import Analytics from '@vercel/analytics/astro';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  hideHeader?: boolean;
  noIndex?: boolean;
}

const {
  title,
  description,
  canonical = "https://suaib.is-a.dev",
  ogImage = "https://suaib.is-a.dev/icon.png",
  hideHeader = false,
  noIndex = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <ClientRouter />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="google-site-verification" content="_xKmImyX8iD4OaXfjFikMU-8Al6xvoFHu66DMYjmVgU" />
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    <style is:inline>
      :root,
      [data-theme="dark"] {
        --primary-color: #ff8c42;
        --primary-rgb: 255, 140, 66;
        --bg-primary: #1a1c1e;
        --bg-secondary: #232529;
        --text-primary: #f2f2f2;
        --text-secondary: #a0a0a5;
        --border-color: rgba(255, 140, 66, 0.1);
        --radius-lg: 24px;
        --radius-md: 16px;
        --radius-sm: 10px;
      }

      [data-theme="light"] {
        --primary-color: #d9480f;
        --primary-rgb: 217, 72, 15;
        --bg-primary: #fcfaf2;
        --bg-secondary: #f4f1e8;
        --text-primary: #1a1c1e;
        --text-secondary: #5a5a60;
        --border-color: rgba(217, 72, 15, 0.15);
      }

      html {
        background-color: var(--bg-primary);
        color: var(--text-primary);
      }

      body {
        background-color: var(--bg-primary);
        color: var(--text-primary);
      }

      a,
      a:visited {
        color: inherit;
        text-decoration: none;
      }
    </style>

    <style is:inline>
      /* Opaque transition cover: the incoming document is never exposed mid-swap. */
      #route-transition-cover {
        position: fixed;
        inset: 0;
        z-index: 2147483647;
        display: grid;
        place-items: center;
        background: var(--bg-primary, #1a1c1e);
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition: opacity 180ms ease, visibility 180ms ease;
      }

      #route-transition-cover.is-visible {
        opacity: 1;
        visibility: visible;
        pointer-events: all;
      }

      #route-transition-cover::after {
        content: "";
        width: 22px;
        height: 22px;
        border: 2px solid var(--border-color, rgba(255, 140, 66, 0.15));
        border-top-color: var(--primary-color, #ff8c42);
        border-radius: 50%;
        animation: route-cover-spin 700ms linear infinite;
      }

      @keyframes route-cover-spin {
        to { transform: rotate(360deg); }
      }

      @media (prefers-reduced-motion: reduce) {
        #route-transition-cover { transition: none; }
        #route-transition-cover::after { animation-duration: 1.5s; }
      }
    </style>

    <script is:inline>
      (function () {
        const getSystemTheme = () => {
          return window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        };
        const theme = getSystemTheme();
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="suaib" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="theme-color" content="#ff8c42" />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonical} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />

    <title>{title}</title>
    <link rel="stylesheet" href="/assets/css/styles.css?v=4" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Lexend:wght@300..800&display=swap"
      rel="stylesheet"
    />
    <link rel="prefetch" href="/projects" />
    <link rel="prefetch" href="/blogs" />
    <link rel="prefetch" href="/connect" />
    <link rel="canonical" href={canonical} />

    <Analytics />

    <script type="application/ld+json" is:inline>
      [
        {
          "@context": "https://schema.org",
          "@type": "WebSite",
          "name": "suaib",
          "alternateName": ["Suaib", "suaibulislam"],
          "url": "https://suaib.is-a.dev/"
        },
        {
          "@context": "https://schema.org",
          "@type": "Person",
          "name": "suaib",
          "description": "i make small things for the internet.",
          "url": "https://suaib.is-a.dev",
          "sameAs": [
            "https://github.com/suaibulislam",
            "https://discord.com/users/1380331017172287571",
            "https://anilist.co/user/blankeed/",
            "https://link.clashofclans.com/?action=OpenPlayerProfile&tag=G2YY2PP9U"
          ],
          "knowsAbout": ["JavaScript", "Python", "React", "Node.js", "Git"],
          "nationality": "Bangladeshi"
        }
      ]
    </script>
  </head>
  <body>
    <div id="route-transition-cover" transition:persist aria-hidden="true"></div>
    <a href="#main-content" class="skip-link">Skip to main content</a>

    {!hideHeader && <Header />}

    <main id="main-content" class="main-content">
      <div class="content-wrapper">
        <slot />
      </div>
    </main>

    <script is:inline>
      (() => {
        const cover = () => document.getElementById("route-transition-cover");
        let safetyTimer;

        document.addEventListener("astro:before-preparation", () => {
          const layer = cover();
          if (!layer) return;
          clearTimeout(safetyTimer);
          layer.classList.add("is-visible");
          // Never leave the site covered if a navigation request stalls.
          safetyTimer = window.setTimeout(() => {
            layer.classList.remove("is-visible");
          }, 15000);
        });

        document.addEventListener("astro:page-load", () => {
          clearTimeout(safetyTimer);
          requestAnimationFrame(() => {
            requestAnimationFrame(() => {
              const layer = cover();
              if (layer) layer.classList.remove("is-visible");
            });
          });
        });
      })();
    </script>
    <script src="/assets/js/script.js" is:inline></script>
  </body>
</html>
