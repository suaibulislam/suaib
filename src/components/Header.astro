---
import Navigation from "./Navigation.astro";
---

<header class="site-header" id="site-header">
  <div class="header-row">
    <div class="header-nav">
      <Navigation />
    </div>
  </div>
</header>

<style>
  /* layout */
  .site-header {
    z-index: 1000;
    background: var(--bg-primary);
    border-bottom: 3px dotted var(--border-color);
    position: relative;
  }

  .header-row {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 4.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: nowrap;
  }

  .header-nav {
    display: flex;
    align-items: center;
  }

  /* mobile */
  @media (max-width: 480px) {
    .header-row {
      padding: 0;
      height: 3.5rem;
      justify-content: center;
      gap: 0;
    }

    .header-nav {
      justify-content: center;
      width: 100%;
      overflow: hidden;
    }
  }
</style>
