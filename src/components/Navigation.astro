---
const currentPath = Astro.url.pathname.replace(/\/$/, "");
const isActive = (path: string) => {
  const normalizedPath = path.replace(/\/$/, "");
  if (normalizedPath === "") return currentPath === "";
  return currentPath.startsWith(normalizedPath);
};
---

<nav class="nav" id="main-nav">
  <div class="nav-links">
    <a href="/" class={`nav-link ${isActive("/") ? "active" : ""}`}>
      <span class="nav-text">hello</span>
    </a>
    <a
      href="/projects"
      class={`nav-link ${isActive("/projects") ? "active" : ""}`}
    >
      <span class="nav-text desktop-label">things i built</span>
      <span class="nav-text mobile-label">projects</span>
    </a>
    <a href="/blogs" class={`nav-link ${isActive("/blogs") ? "active" : ""}`}>
      <span class="nav-text">blogs</span>
    </a>
    <a
      href="/connect"
      class={`nav-link ${isActive("/connect") ? "active" : ""}`}
    >
      <span class="nav-text">connect</span>
    </a>
  </div>
</nav>

<style>
  /* base */
  .nav {
    display: flex;
    align-items: center;
  }

  .nav-links {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    flex-wrap: nowrap;
  }

  /* tab */
  .nav-link {
    color: var(--text-secondary);
    text-decoration: none;
    font-family: "Lexend", sans-serif;
    font-size: 1rem;
    font-weight: 700;
    padding: 0.5rem 1rem;
    border-radius: var(--radius-sm, 6px);
    transition: color 0.25s ease, background 0.25s ease;
    text-transform: lowercase;
    letter-spacing: 0.02em;
    position: relative;
    white-space: nowrap;
    border: 1px solid transparent;
  }

  /* hover & active */
  .nav-link:hover {
    color: var(--text-primary);
    background: rgba(var(--primary-rgb), 0.08);
  }

  .nav-link.active {
    color: var(--primary-color);
    background: rgba(var(--primary-rgb), 0.08);
    font-weight: 700;
  }

  /* label switching */
  .mobile-label { display: none; }
  .desktop-label { display: inline; }

  /* mobile scroll */
  @media (max-width: 480px) {
    .nav {
      width: 100%;
      margin: 0;
    }

    .nav-links {
      display: flex !important;
      flex-direction: row !important;
      flex-wrap: nowrap !important;
      justify-content: safe center;
      gap: 0.4rem;
      width: 100%;
      overflow-x: auto;
      padding: 0 0.75rem 4px;
      scrollbar-width: none;
      -ms-overflow-style: none;
      -webkit-overflow-scrolling: touch;
    }

    .nav-links::-webkit-scrollbar { display: none; }

    .nav-link {
      padding: 0.3rem 0.5rem;
      font-size: 0.8rem;
      border: 1px dotted transparent;
      text-transform: lowercase !important;
    }

    .mobile-label { display: inline; }
    .desktop-label { display: none; }
  }
</style>
